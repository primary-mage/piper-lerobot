#!/usr/bin/env bash
# =====================================================================
# 松灵 Piper + LeRobot 全局配置
# 所有脚本都会 source 本文件。改这里即可，不用逐个脚本改。
# =====================================================================

# ---------- 硬件：CAN 总线 ----------
CAN_INTERFACE="can0"            # AgileX USB-CAN 模块默认 can0
CAN_BITRATE="1000000"           # Piper 默认 1 Mbps

# ---------- 相机（采集/部署用，opencv 打开，JSON 字符串） ----------
# 多个相机时改 index_or_path（0 通常 = /dev/video0）；分辨率高占显存大，5060 建议 640x480
CAMERA_JSON='{"wrist": {"type": "opencv", "index_or_path": 0, "width": 640, "height": 480, "fps": 30, "fourcc": "MJPG"}}'

# ---------- 遥操作设备（三选一，改成你实际有的设备） ----------
# 1) SO-101 主臂（拖动示教，最常见）：
TELEOP_TYPE="so101_leader"
TELEOP_ARGS="--teleop.port=/dev/ttyACM0 --teleop.use_degrees=false"
# 2) SpaceMouse（需先 pip install lerobot-teleoperator-spacemouse）：
# TELEOP_TYPE="spacemouse"
# TELEOP_ARGS=""
# 3) PiperMate 主臂（需装 FashionStar 插件，见 README.md 第 5 节）：
# TELEOP_TYPE="pipermate"
# TELEOP_ARGS=""

# ---------- 数据集 ----------
DATASET_ROOT="$HOME/lerobot_datasets"   # 数据集本地存储目录
DATASET_REPO_ID="local/piper-grasp"     # 本地数据集 ID（采集和训练用同一个）
TASK_DESCRIPTION="pick and place"       # 任务描述，写清楚抓什么，如 "grab the red cube and place it into the box"
NUM_EPISODES="50"                        # 采集条数：先 50 条验证流程，再视效果加到 100+
EPISODE_TIME_S="45"
RESET_TIME_S="10"

# ---------- ACT 训练（针对 RTX 5060 8GB 显存优化） ----------
BATCH_SIZE="4"                          # 8GB 显存用 4 最稳；数据少可试 8
STEPS="50000"                           # 总训练步数。约等于 epochs × (总帧数/batch)。
                                        # 50条×45s×30fps≈6.75万帧，batch4 时 10 epoch≈17万步；
                                        # 小数据集建议先跑 5 万步看效果，再决定是否加。
OUTPUT_DIR="$HOME/lerobot_outputs/act_piper_grasp"  # 训练输出目录（含任务名）
JOB_NAME="act_piper_grasp"              # 本次训练任务名（wandb/日志标签）

# ---------- 部署 ----------
# 训练结束后检查点保存在 $OUTPUT_DIR/checkpoints/ 下，
# 把下面指向你最新的检查点目录（通常是 checkpoints/last/pretrained_model 或 step 数字目录）
POLICY_PATH="${OUTPUT_DIR}/checkpoints/last/pretrained_model"
